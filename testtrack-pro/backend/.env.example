# ==================== DATABASE CONFIGURATION ====================
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=testtrack_pro
MYSQL_PORT=3306

# ==================== FLASK CONFIGURATION ====================
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# ==================== SECURITY ====================
JWT_SECRET_KEY=your-jwt-secret-key
PASSWORD_RESET_EXPIRY=3600
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT=900

# ==================== EMAIL CONFIGURATION ====================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDR=TestTrack Pro <noreply@testtrack.com>

# ==================== FILE UPLOAD ====================
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=./uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt,log,mp4,avi,mov

# ==================== CLOUDINARY (Optional - for file storage) ====================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/testtrack.log

# ==================== API CONFIGURATION ====================
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ==================== PRODUCTION ====================
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1
